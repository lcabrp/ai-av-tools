# Copy to .env and fill in the keys you use.
# OPENAI_API_KEY drives the default summary provider (gpt-6-luna).
# GEMINI_API_KEY is the fallback provider (gemini-flash-latest).
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: only needed for --provider anthropic comparisons/benchmarks.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
